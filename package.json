  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:paramotor && npm run build:megastar",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:paramotor": "npm ci --prefix paramotor && npm run build --prefix paramotor",
    "build:megastar": "npm ci --prefix megastar && npm run build --prefix megastar",
    "dev:megastar": "npm run dev --prefix megastar",
    "test:paramotor": "npm test --prefix paramotor"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.50.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
